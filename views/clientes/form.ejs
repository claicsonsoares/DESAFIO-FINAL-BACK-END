<%- include('../partials/navbar') %>
<%- include('../partials/sidebar') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0"><%= cliente._id ? 'Editar Cliente' : 'Novo Cliente' %></h1>
  <a href="/clientes" class="btn btn-outline-secondary btn-sm">← Voltar para a lista</a>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <form action="<%= acao %>" method="<%= metodo %>" class="row g-3">
      <div class="col-md-6">
        <label for="nome" class="form-label">Nome Completo *</label>
        <input
          type="text"
          class="form-control"
          id="nome"
          name="nome"
          required
          value="<%= cliente.nome || '' %>"
          placeholder="Ex.: Claicson Soares"
        />
      </div>

      <div class="col-md-6">
        <label for="telefone" class="form-label">Telefone *</label>
        <input
          type="text"
          class="form-control"
          id="telefone"
          name="telefone"
          required
          value="<%= cliente.telefone || '' %>"
          placeholder="Ex.: (51) 99777-8899"
        />
      </div>

      <div class="col-md-6">
        <label for="cidade" class="form-label">Cidade *</label>
        <input
          type="text"
          class="form-control"
          id="cidade"
          name="cidade"
          required
          value="<%= cliente.cidade || '' %>"
          placeholder="Ex.: Sobradinho-RS"
        />
      </div>

      <div class="col-md-6">
        <label for="endereco" class="form-label">Endereço de Instalação *</label>
        <input
          type="text"
          class="form-control"
          id="endereco"
          name="endereco"
          required
          value="<%= cliente.endereco || '' %>"
          placeholder="Ex.: Rua Juarez, 57"
        />
      </div>

      <div class="col-12">
        <div class="form-check">
          <input
            class="form-check-input"
            type="checkbox"
            id="ativo"
            name="ativo"
            <%= (cliente.ativo === undefined || cliente.ativo) ? 'checked' : '' %>
          />
          <label class="form-check-label" for="ativo">
            Cliente ativo no sistema
          </label>
        </div>
      </div>

      <div class="col-12 d-flex gap-2 mt-4">
        <button type="submit" class="btn btn-warning fw-semibold">Salvar Cliente</button>
        <a href="/clientes" class="btn btn-outline-secondary">Cancelar</a>
      </div>
    </form>
  </div>
</div>

<%- include('../partials/footer') %>