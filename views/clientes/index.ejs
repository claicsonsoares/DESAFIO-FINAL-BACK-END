<%- include('../partials/navbar') %>
<%- include('../partials/sidebar') %>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
  <div>
    <h1 class="h3 mb-0">Clientes</h1>
    <small class="text-muted">Gerenciamento de proprietários e endereços de instalação</small>
  </div>
  <a href="/clientes/novo" class="btn btn-warning fw-semibold">+ Novo Cliente</a>
</div>

<!-- Filtro / Pesquisa -->
<div class="card border-0 shadow-sm mb-4">
  <div class="card-body">
    <form action="/clientes" method="GET" class="row g-3 align-items-end">
      <div class="col-md-5">
        <label for="busca" class="form-label">Nome do Cliente</label>
        <input
          type="text"
          class="form-control"
          id="busca"
          name="busca"
          placeholder="Ex.: Claicson..."
          value="<%= filtros.busca %>"
        />
      </div>
      <div class="col-md-4">
        <label for="cidade" class="form-label">Cidade</label>
        <input
          type="text"
          class="form-control"
          id="cidade"
          name="cidade"
          placeholder="Ex.: Sobradinho-RS"
          value="<%= filtros.cidade %>"
        />
      </div>
      <div class="col-md-3 d-flex gap-2">
        <button type="submit" class="btn btn-dark w-100">Filtrar</button>
        <a href="/clientes" class="btn btn-outline-secondary">Limpar</a>
      </div>
    </form>
  </div>
</div>

<!-- Tabela de Listagem -->
<div class="card border-0 shadow-sm">
  <div class="table-responsive">
    <table class="table table-hover align-middle mb-0">
      <thead class="table-light">
        <tr>
          <th>Nome</th>
          <th>Cidade</th>
          <th>Telefone</th>
          <th>Status</th>
          <th class="text-end">Ações</th>
        </tr>
      </thead>
      <tbody>
        <% if (clientes.length === 0) { %>
          <tr>
            <td colspan="5" class="text-center text-muted py-4">
              Nenhum cliente encontrado.
            </td>
          </tr>
        <% } else { %>
          <% clientes.forEach(cliente => { %>
            <tr>
              <td class="fw-semibold"><%= cliente.nome %></td>
              <td><%= cliente.cidade %></td>
              <td><%= cliente.telefone %></td>
              <td>
                <% if (cliente.ativo) { %>
                  <span class="badge bg-success">Ativo</span>
                <% } else { %>
                  <span class="badge bg-secondary">Inativo</span>
                <% } %>
              </td>
              <td class="text-end">
                <a href="/clientes/<%= cliente._id %>" class="btn btn-sm btn-outline-secondary">Ver</a>
                <a href="/clientes/<%= cliente._id %>/editar" class="btn btn-sm btn-outline-primary">Editar</a>
                <form
                  action="/clientes/<%= cliente._id %>?_method=DELETE"
                  method="POST"
                  class="d-inline"
                  onsubmit="return confirm('Deseja realmente excluir este cliente?');"
                >
                  <button type="submit" class="btn btn-sm btn-outline-danger">Excluir</button>
                </form>
              </td>
            </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/footer') %>