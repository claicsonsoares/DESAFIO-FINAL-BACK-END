<%- include('../partials/navbar') %>
<%- include('../partials/sidebar') %>

<div class="d-flex justify-content-between align-items-center mb-4">
  <h1 class="h3 mb-0">Detalhes do Cliente</h1>
  <div class="d-flex gap-2">
    <a href="/clientes/<%= cliente._id %>/editar" class="btn btn-primary btn-sm">Editar</a>
    <a href="/clientes" class="btn btn-outline-secondary btn-sm">← Voltar</a>
  </div>
</div>

<div class="card border-0 shadow-sm">
  <div class="card-body">
    <dl class="row mb-0">
      <dt class="col-sm-3 text-muted">ID no Banco</dt>
      <dd class="col-sm-9"><code><%= cliente._id %></code></dd>

      <dt class="col-sm-3 text-muted">Nome</dt>
      <dd class="col-sm-9 fw-semibold"><%= cliente.nome %></dd>

      <dt class="col-sm-3 text-muted">Telefone</dt>
      <dd class="col-sm-9"><%= cliente.telefone %></dd>

      <dt class="col-sm-3 text-muted">Cidade</dt>
      <dd class="col-sm-9"><%= cliente.cidade %></dd>

      <dt class="col-sm-3 text-muted">Endereço</dt>
      <dd class="col-sm-9"><%= cliente.endereco %></dd>

      <dt class="col-sm-3 text-muted">Status</dt>
      <dd class="col-sm-9">
        <% if (cliente.ativo) { %>
          <span class="badge bg-success">Ativo</span>
        <% } else { %>
          <span class="badge bg-secondary">Inativo</span>
        <% } %>
      </dd>
    </dl>
  </div>
</div>

<%- include('../partials/footer') %>